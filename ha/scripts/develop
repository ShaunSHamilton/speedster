#!/usr/bin/env bash
# Run a throwaway Home Assistant with the integration loaded from this checkout.
#
#   ha/scripts/develop
#
# The config lives in ha/devcfg (gitignored). The integration is symlinked, so an
# edit plus a restart is the whole loop.
set -euo pipefail

cd "$(dirname "$0")/.."

if [ ! -d .venv ]; then
  python3 -m venv .venv
  ./.venv/bin/pip install --upgrade pip
  ./.venv/bin/pip install -r requirements-dev.txt
fi

rm -rf devcfg/custom_components/speedster
mkdir -p devcfg/custom_components/speedster
# Link each package entry so source edits remain live without writing dev-only files
# into tracked integration directory.
ln -sfn "$PWD/../custom_components/speedster/"* devcfg/custom_components/speedster/
ln -sfn "$PWD/../portal.html" devcfg/custom_components/speedster/portal.html

if [ ! -f devcfg/configuration.yaml ]; then
  cat > devcfg/configuration.yaml <<'YAML'
default_config:
logger:
  default: info
  logs:
    custom_components.speedster: debug
YAML
fi

exec ./.venv/bin/python -m homeassistant --config devcfg --debug
